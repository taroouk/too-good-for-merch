# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.next
node_modules
out
dist
# NOTE: do not add a bare "build" pattern here -- it previously matched
# app/api/build/ (real route source, not build output) at any depth with no
# leading/trailing slash, silently keeping app/api/build/[id]/route.ts and
# app/api/build/create/route.ts out of every commit ever pushed. The
# root-level build-output folder this was meant to ignore is already
# covered by the anchored "/build" pattern above.
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env.local
/storage/

# macOS
.DS_Store
# test harness scratch output
tmp/
.render-test-build/
.payments-test-build/
