generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String?         @unique
  createdAt    DateTime        @default(now())
  phone        String?         @unique
  updatedAt    DateTime        @updatedAt
  passwordHash String?
  role         Role            @default(USER)
  blockedAt    DateTime?
  accounts     Account[]
  adminNotes   AdminNote[]
  builds       Build[]
  orders       Order[]
  sessions     Session[]
  auditLogs    AdminAuditLog[]
}

model Build {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String?
  userId    String?
  status    BuildStatus @default(ACTIVE)
  assets    Asset[]
  user      User?       @relation(fields: [userId], references: [id])
  draft     BuildDraft?
  designs   Design[]
  orders    Order[]
  mockups   Mockup[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BuildDraft {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  buildId        String        @unique
  product        ProductType?
  color          GarmentColor?
  fabric         FabricType?
  quantity       Int           @default(1)
  customNotes    String?
  primaryAssetId String?
  build          Build         @relation(fields: [buildId], references: [id], onDelete: Cascade)
  primaryAsset   Asset?        @relation("DraftPrimaryAsset", fields: [primaryAssetId], references: [id])

  printMockupId           String?       @map("printMockupId")
  printMockupFingerprint    String?       @map("printMockupFingerprint")
  printMockupGeneratedAt  DateTime?     @map("printMockupGeneratedAt")
  printMockup             Mockup?       @relation("PrintMockup", fields: [printMockupId], references: [id])

  aiMockupId              String?       @map("aiMockupId")
  aiMockupFingerprint     String?       @map("aiMockupFingerprint")
  aiMockupGeneratedAt    DateTime?     @map("aiMockupGeneratedAt")
  aiMockup                Mockup?       @relation("AiMockup", fields: [aiMockupId], references: [id])
}

model Mockup {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  kind           MockupKind  @default(AI)
  parentId       String?
  width          Int?
  height         Int?
  buildId        String
  build          Build        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  printDrafts   BuildDraft[] @relation("PrintMockup")
  aiDrafts       BuildDraft[] @relation("AiMockup")
  assetId        String?
  mimeType       String?
  data           Bytes
  sha256         String?      @db.VarChar(64)
  model          String?
  placement      String?
  fingerprint    String?
  prompt         String?

  @@index([buildId])
  @@index([fingerprint])
  @@index([kind])
}

model Asset {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  buildId         String
  status          AssetStatus       @default(PENDING_UPLOAD)
  fileName        String            @map("filename")
  mimeType        String?           @map("contentType")
  sizeBytes       Int?              @map("fileSize")
  uploadedAt      DateTime          @default(now())
  artworkData     Bytes?
  artworkSha256   String?           @db.VarChar(64)
  storageKey      String?
  url             String?
  build           Build             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  usedAsPrimaryIn BuildDraft[]      @relation("DraftPrimaryAsset")
  placements      DesignPlacement[]
  orderItems      OrderItem[]

  @@index([buildId])
}

model Design {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  buildId    String
  name       String?
  build      Build             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  placements DesignPlacement[]
}

model DesignPlacement {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  designId  String
  placement PlacementType
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id])
  design    Design        @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, placement])
}

model Order {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  userId               String?
  buildId              String?
  currency             String           @default("EGP")
  customerEmail        String?
  customerName         String?
  customerPhone        String?
  orderNumber          String           @unique
  paymentStatus        PaymentStatus    @default(UNPAID)
  paymentMethod        PaymentMethod?
  paymentUrl           String?
  paymobIntentionId    String?
  paymobOrderId        String?
  paymobTransactionId  String?
  paymentFailureReason String?
  paidAt               DateTime?
  refundedAt           DateTime?
  subtotalCents        Int
  totalCents           Int
  // Canonical pricing snapshot, distinct from totalCents/currency above
  // (which are, and remain, the actual payment amount/currency sent to
  // Paymob). Null on every order created before this model existed --
  // never backfilled, never guessed. See src/lib/orders/checkout.ts.
  canonicalTotalUsdCents Int?
  exchangeRateUsed       Float?
  exchangeRateAt         DateTime?
  status               OrderStatus      @default(NEW)
  notes                AdminNote[]
  build                Build?           @relation(fields: [buildId], references: [id])
  user                 User?            @relation(fields: [userId], references: [id])
  items                OrderItem[]
  paymentAttempts      PaymentAttempt[]
  webhookEvents        WebhookEvent[]
  auditLogs            AdminAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  orderId        String
  assetId        String?
  color          GarmentColor
  fabric         FabricType
  placements     Json
  preview        Json?
  product        ProductType
  quantity       Int
  totalCents     Int
  unitPriceCents Int
  asset          Asset?       @relation(fields: [assetId], references: [id])
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AdminNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  orderId   String
  authorId  String?
  body      String
  author    User?    @relation(fields: [authorId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PaymentAttempt {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  orderId       String
  provider      String               @default("PAYMOB")
  method        PaymentMethod
  status        PaymentAttemptStatus @default(CREATED)
  amountCents   Int
  currency      String
  externalId    String?
  paymentUrl    String?
  failureReason String?
  metadata      Json?
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  eventKey       String    @unique
  eventType      String
  transactionId  String?
  validSignature Boolean
  processed      Boolean   @default(false)
  processedAt    DateTime?
  errorMessage   String?
  payload        Json
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([transactionId])
  @@index([createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  adminId       String?
  orderId       String?
  action        String
  previousValue String?
  newValue      String?
  metadata      Json?
  admin         User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([orderId])
  @@index([createdAt])
}

model StoreSetting {
  id            String   @id @default("store")
  storeName     String   @default("Too Good For Merch")
  currency      String   @default("USD")
  taxRateBps    Int      @default(0)
  shippingCents Int      @default(0)
  // EGP per 1 USD, admin-configured. Null means "not configured yet" --
  // checkout must fail closed, never guess a rate. Only affects orders
  // created after it's set; existing orders keep their own frozen
  // Order.exchangeRateUsed regardless of later changes here.
  usdToEgpRate  Float?
  updatedAt     DateTime @updatedAt
}

model PricingRule {
  id        String   @id @default(cuid())
  product   String
  fabric    String
  minQty    Int
  maxQty    Int
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([product])
  @@index([fabric])
  @@index([minQty])
  @@index([maxQty])
}

model PlacementPricingRule {
  id        String        @id @default(cuid())
  placement PlacementType @unique
  unitPrice Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([placement])
}

enum Role {
  ADMIN
  USER
}

enum BuildStatus {
  ACTIVE
  ARCHIVED
}

enum ProductType {
  FITTED
  OVERSIZED
  CUSTOM
}

enum GarmentColor {
  BLACK
  WHITE
  CUSTOM
}

enum FabricType {
  ESSENTIALS_170
  SIGNATURE_200
  HEAVYWEIGHT_300
}

enum AssetStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

enum MockupKind {
  PRINT
  AI
}

enum PlacementType {
  LEFT_CHEST
  RIGHT_CHEST
  RIGHT_SLEEVE
  LEFT_SLEEVE
  CENTER_FRONT
  FULL_FRONT
  CENTER_BACK
  FULL_BACK
}

enum OrderStatus {
  NEW
  PAID
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
}
