generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String?         @unique
  createdAt    DateTime        @default(now())
  phone        String?         @unique
  updatedAt    DateTime        @updatedAt
  passwordHash String?
  role         Role            @default(USER)
  blockedAt    DateTime?
  accounts     Account[]
  adminNotes   AdminNote[]
  builds       Build[]
  orders       Order[]
  sessions     Session[]
  auditLogs    AdminAuditLog[]
  artworks            Artwork[]
  wishlistItems       WishlistItem[]
  bespokeRequests     BespokeRequest[]
  bespokeRequestNotes BespokeRequestNote[]
}

model Build {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String?
  userId    String?
  status    BuildStatus @default(ACTIVE)
  assets    Asset[]
  user      User?       @relation(fields: [userId], references: [id])
  draft     BuildDraft?
  designs   Design[]
  orders    Order[]
  mockups   Mockup[]
  artworks        Artwork[]
  wishlistItems   WishlistItem[]
  bespokeRequests BespokeRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BuildDraft {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  buildId        String        @unique
  product        ProductType?
  color          GarmentColor?
  fabric         FabricType?
  quantity       Int           @default(1)
  customNotes    String?
  primaryAssetId String?
  build          Build         @relation(fields: [buildId], references: [id], onDelete: Cascade)
  primaryAsset   Asset?        @relation("DraftPrimaryAsset", fields: [primaryAssetId], references: [id])

  printMockupId           String?       @map("printMockupId")
  printMockupFingerprint    String?       @map("printMockupFingerprint")
  printMockupGeneratedAt  DateTime?     @map("printMockupGeneratedAt")
  printMockup             Mockup?       @relation("PrintMockup", fields: [printMockupId], references: [id])

  aiMockupId              String?       @map("aiMockupId")
  aiMockupFingerprint     String?       @map("aiMockupFingerprint")
  aiMockupGeneratedAt    DateTime?     @map("aiMockupGeneratedAt")
  aiMockup                Mockup?       @relation("AiMockup", fields: [aiMockupId], references: [id])

  // The canonical, owner-scoped generated artwork the customer explicitly
  // SAVEd in the Studio model (src/actions/artwork-actions.ts). Distinct
  // from aiMockupId above: aiMockup is a Build-scoped, cascade-deleted
  // preview row; savedArtwork owns its own copy of the exact generated
  // bytes and is what Wishlist / BespokeRequest / Admin reference. Null
  // until the user hits "Save T-Shirt".
  savedArtworkId String?
  savedArtwork   Artwork? @relation("DraftSavedArtwork", fields: [savedArtworkId], references: [id])

  // Canvas placement/config snapshot: { placement, x, y, scale, rotation }.
  // The placement *key* is also in customNotes JSON (legacy, used by
  // pricing); this additionally persists the x/y/scale transform so the
  // Studio canvas survives a refresh and so Wishlist/BespokeRequest can
  // snapshot it. Never baked into the Artwork bytes -- see the Sharp
  // compositor, which still receives transform numbers per-request.
  artworkPlacement Json?

  // Admin-set price for a Bespoke/Custom (product == CUSTOM) build -- the
  // only way a CUSTOM product ever gets a real price, since computePrice()
  // always returns mode:"custom" for it (see src/pricing/engine.ts). Valid
  // only for the exact draft state it was quoted against: actionUpdateDraft
  // (src/actions/build-actions.ts) clears all four fields the moment
  // product/color/fabric/quantity/customNotes/primaryAssetId change, so a
  // stale quote can never be silently reused for a materially different
  // request. Denormalized quoter email (no User relation) is enough of an
  // audit trail without the extra relation/migration complexity.
  customQuoteUsdCents  Int?
  customQuoteNote      String?
  customQuotedAt       DateTime?
  customQuotedByEmail  String?
}

model Mockup {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  kind           MockupKind  @default(AI)
  parentId       String?
  width          Int?
  height         Int?
  buildId        String
  build          Build        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  printDrafts   BuildDraft[] @relation("PrintMockup")
  aiDrafts       BuildDraft[] @relation("AiMockup")
  assetId        String?
  mimeType       String?
  data           Bytes
  sha256         String?      @db.VarChar(64)
  model          String?
  placement      String?
  fingerprint    String?
  prompt         String?

  @@index([buildId])
  @@index([fingerprint])
  @@index([kind])
}

model Asset {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  buildId         String
  status          AssetStatus       @default(PENDING_UPLOAD)
  fileName        String            @map("filename")
  mimeType        String?           @map("contentType")
  sizeBytes       Int?              @map("fileSize")
  uploadedAt      DateTime          @default(now())
  artworkData     Bytes?
  artworkSha256   String?           @db.VarChar(64)
  storageKey      String?
  url             String?
  build           Build             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  usedAsPrimaryIn BuildDraft[]      @relation("DraftPrimaryAsset")
  placements      DesignPlacement[]
  orderItems      OrderItem[]

  @@index([buildId])
}

model Design {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  buildId    String
  name       String?
  build      Build             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  placements DesignPlacement[]
}

model DesignPlacement {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  designId  String
  placement PlacementType
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id])
  design    Design        @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, placement])
}

model Order {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  userId               String?
  buildId              String?
  currency             String           @default("EGP")
  customerEmail        String?
  customerName         String?
  customerPhone        String?
  orderNumber          String           @unique
  paymentStatus        PaymentStatus    @default(UNPAID)
  paymentMethod        PaymentMethod?
  paymentUrl           String?
  paymobIntentionId    String?
  paymobOrderId        String?
  paymobTransactionId  String?
  paymentFailureReason String?
  paidAt               DateTime?
  refundedAt           DateTime?
  subtotalCents        Int
  totalCents           Int
  // Canonical pricing snapshot, distinct from totalCents/currency above
  // (which are, and remain, the actual payment amount/currency sent to
  // Paymob). Null on every order created before this model existed --
  // never backfilled, never guessed. See src/lib/orders/checkout.ts.
  canonicalTotalUsdCents Int?
  exchangeRateUsed       Float?
  exchangeRateAt         DateTime?
  status               OrderStatus      @default(NEW)
  notes                AdminNote[]
  build                Build?           @relation(fields: [buildId], references: [id])
  user                 User?            @relation(fields: [userId], references: [id])
  items                OrderItem[]
  paymentAttempts      PaymentAttempt[]
  webhookEvents        WebhookEvent[]
  auditLogs            AdminAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  orderId        String
  assetId        String?
  color          GarmentColor
  fabric         FabricType
  placements     Json
  preview        Json?
  product        ProductType
  quantity       Int
  totalCents     Int
  unitPriceCents Int
  asset          Asset?       @relation(fields: [assetId], references: [id])
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AdminNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  orderId   String
  authorId  String?
  body      String
  author    User?    @relation(fields: [authorId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PaymentAttempt {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  orderId       String
  provider      String               @default("PAYMOB")
  method        PaymentMethod
  status        PaymentAttemptStatus @default(CREATED)
  amountCents   Int
  currency      String
  externalId    String?
  paymentUrl    String?
  failureReason String?
  metadata      Json?
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  eventKey       String    @unique
  eventType      String
  transactionId  String?
  validSignature Boolean
  processed      Boolean   @default(false)
  processedAt    DateTime?
  errorMessage   String?
  payload        Json
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([transactionId])
  @@index([createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  adminId       String?
  orderId       String?
  bespokeRequestId String?
  action        String
  previousValue String?
  newValue      String?
  metadata      Json?
  admin         User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bespokeRequest BespokeRequest? @relation(fields: [bespokeRequestId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([orderId])
  @@index([bespokeRequestId])
  @@index([createdAt])
}

// Canonical, owner-scoped persistent generated artwork -- the single
// source of truth referenced by the Builder, Wishlist, BespokeRequest,
// Admin, and rendering. Owns its OWN copy of the exact generated image
// bytes (copied verbatim from the source Mockup at SAVE time) so it
// survives the source Build/Mockup being deleted. Holds ONLY the asset;
// placement/transform lives on BuildDraft.artworkPlacement and is
// snapshotted onto WishlistItem/BespokeRequest.
model Artwork {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String?
  buildId        String?
  // The Mockup(kind="AI") row these bytes were copied from. Unique so
  // re-saving the same generated mockup UPSERTs one Artwork instead of
  // creating a duplicate every time the user re-opens the model.
  sourceMockupId String?  @unique
  mimeType       String
  data           Bytes
  sha256         String   @db.VarChar(64)
  model          String?
  prompt         String?
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  build Build? @relation(fields: [buildId], references: [id], onDelete: SetNull)

  draftsUsingAsSaved BuildDraft[]     @relation("DraftSavedArtwork")
  wishlistItems      WishlistItem[]
  bespokeRequests    BespokeRequest[]

  @@index([userId])
  @@index([buildId])
}

model WishlistItem {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     String
  buildId    String
  artworkId  String?
  product    ProductType?
  color      GarmentColor?
  fabric     FabricType?
  quantity   Int           @default(1)
  size       String?
  placements Json
  transform  Json?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  build   Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  artwork Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  @@unique([userId, buildId])
  @@index([userId])
}

// A no-payment "please quote this for me" intake for a Bespoke/Custom
// build. Never touches Paymob. Captures an immutable snapshot of the
// Builder state at request time; the tailored quote is filled in later by
// an admin (mirrors BuildDraft.customQuote*).
model BespokeRequest {
  id            String               @id @default(cuid())
  requestNumber String               @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userId        String?
  buildId       String?
  artworkId     String?
  status        BespokeRequestStatus @default(NEW)

  product     ProductType?
  color       GarmentColor?
  fabric      FabricType?
  quantity    Int           @default(1)
  size        String?
  placements  Json
  transform   Json?
  customNotes String?

  customerName  String
  customerEmail String
  customerPhone String

  quoteUsdCents Int?
  quoteNote     String?
  quotedAt      DateTime?
  quotedByEmail String?

  emailNotifiedAt    DateTime?
  whatsappNotifiedAt DateTime?
  notifyError        String?

  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  build     Build?               @relation(fields: [buildId], references: [id], onDelete: SetNull)
  artwork   Artwork?             @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  notes     BespokeRequestNote[]
  auditLogs AdminAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BespokeRequestNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  requestId String
  authorId  String?
  body      String
  request BespokeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model StoreSetting {
  id            String   @id @default("store")
  storeName     String   @default("Too Good For Merch")
  currency      String   @default("USD")
  taxRateBps    Int      @default(0)
  shippingCents Int      @default(0)
  // EGP per 1 USD, admin-configured. Null means "not configured yet" --
  // checkout must fail closed, never guess a rate. Only affects orders
  // created after it's set; existing orders keep their own frozen
  // Order.exchangeRateUsed regardless of later changes here.
  usdToEgpRate  Float?
  updatedAt     DateTime @updatedAt
}

model PricingRule {
  id        String   @id @default(cuid())
  product   String
  fabric    String
  minQty    Int
  maxQty    Int
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([product])
  @@index([fabric])
  @@index([minQty])
  @@index([maxQty])
}

model PlacementPricingRule {
  id        String        @id @default(cuid())
  placement PlacementType @unique
  unitPrice Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([placement])
}

enum Role {
  ADMIN
  USER
}

enum BuildStatus {
  ACTIVE
  ARCHIVED
}

enum ProductType {
  FITTED
  OVERSIZED
  CUSTOM
}

enum GarmentColor {
  BLACK
  WHITE
  CUSTOM
}

enum FabricType {
  ESSENTIALS_170
  SIGNATURE_200
  HEAVYWEIGHT_300
}

enum AssetStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

enum MockupKind {
  PRINT
  AI
}

enum PlacementType {
  LEFT_CHEST
  RIGHT_CHEST
  RIGHT_SLEEVE
  LEFT_SLEEVE
  CENTER_FRONT
  FULL_FRONT
  CENTER_BACK
  FULL_BACK
}

enum OrderStatus {
  NEW
  PAID
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
}

enum BespokeRequestStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
}
