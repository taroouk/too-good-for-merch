# Copy this file to .env (server-only secrets) and/or .env.local (local
# overrides) and fill in real values. Never commit .env or .env.local.
#
# Run `npm run check:prod` to validate these before a production deploy.
# instrumentation.ts also fails the server boot in production if a
# required variable below is missing.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/tgfm"

# ---------------------------------------------------------------------------
# Auth (required) - next-auth v4 (NEXTAUTH_*, not the v5 AUTH_* naming)
# ---------------------------------------------------------------------------
# The canonical origin NextAuth uses to validate redirect/callback URLs and
# build absolute links. Set this to wherever THIS instance is actually
# served from:
#   local dev:   http://localhost:3000  (must match the port npm run dev uses)
#   production:  https://your-real-domain  (https, no trailing slash)
# Never set this to the production domain in a local .env/.env.local - a
# local dev server that trusts a different origin will silently redirect
# login/logout to that other origin instead of staying on localhost.
# On Vercel specifically, the platform sets VERCEL=1 automatically at
# runtime, which makes next-auth derive the origin from the live request
# instead of this variable - but NEXTAUTH_URL should still be set correctly
# in each environment's own config (Vercel project settings for production,
# this local file for dev); do not rely on that fallback in other hosts.
# Production's value belongs in your hosting platform's environment variable
# settings (e.g. Vercel project settings), NOT in this repo - .env/.env.local
# are local-only and gitignored, so they can never reach a real deployment.
NEXTAUTH_URL="http://localhost:3000"
# Long random secret used to sign auth tokens. Generate with:
#   openssl rand -base64 32
# Must be at least 32 characters. Use a DIFFERENT value in production than
# in local dev.
NEXTAUTH_SECRET="replace-with-a-random-32-plus-character-secret"

# ---------------------------------------------------------------------------
# Admin bootstrap (optional)
# ---------------------------------------------------------------------------
# Comma-separated emails that are treated as admins.
ADMIN_EMAILS=""
# Used only by `npm run db:seed:admins` (scripts/seed-admins.mjs), not read
# at request time. Either set ADMIN_SEED_USERS ("email:password,..."), or
# set ADMIN_EMAILS above plus ADMIN_SEED_PASSWORD for a shared password.
ADMIN_SEED_USERS=""
ADMIN_SEED_PASSWORD=""

# ---------------------------------------------------------------------------
# Payments - Paymob (required for checkout in production)
# ---------------------------------------------------------------------------
# Server API key from the Paymob dashboard. Server-only, never expose to the client.
PAYMOB_API_KEY="replace-with-paymob-api-key"
# Card payment integration ID (Paymob dashboard > Integrations).
PAYMOB_INTEGRATION_ID="replace-with-paymob-integration-id"
# Hosted card payment iframe ID (Paymob dashboard > iFrames).
PAYMOB_IFRAME_ID="replace-with-paymob-iframe-id"
# HMAC secret used to verify Paymob webhook/callback signatures. Server-only.
PAYMOB_HMAC_SECRET="replace-with-paymob-hmac-secret"
# Optional: enables mobile wallet as a payment method when set.
PAYMOB_WALLET_INTEGRATION_ID=""

# In the Paymob dashboard, point the integration's callbacks at:
#   Transaction processed callback (server-to-server, POST): {NEXTAUTH_URL}/api/payments/paymob/webhook
#   Transaction response callback  (browser redirect, GET):  {NEXTAUTH_URL}/api/payments/paymob/verify
# Do not point either callback at /payments/success or /payments/failed -
# those routes do not verify anything and only redirect to /orders.

# ---------------------------------------------------------------------------
# Store / pricing (optional)
# ---------------------------------------------------------------------------
# Fallback 3-letter ISO currency code used when StoreSetting has none configured.
# This MUST match a currency actually enabled on your PAYMOB_INTEGRATION_ID in
# the Paymob dashboard, or payment_keys requests fail with "Invalid currency
# sent". Defaults to EGP in code (this integration's billing_data is
# Egypt-only); override here or via /admin/settings if your account differs.
STORE_CURRENCY="EGP"

# ---------------------------------------------------------------------------
# AI mockup generation (optional - unrelated to payments)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL=""

# ---------------------------------------------------------------------------
# Bespoke request notifications (optional - all channels degrade gracefully)
# ---------------------------------------------------------------------------
# When a customer submits a bespoke request, the app sends a confirmation
# email to the customer and (optionally) an email + WhatsApp to the team.
# With none of these set the request is still created and stored -- the
# notification is simply skipped and logged. A send failure never fails or
# deletes a request.
#
# Email transport: Resend HTTP API (no dependency). Unset RESEND_API_KEY to
# disable all email.
RESEND_API_KEY=""
# From address for outbound email, e.g. "Too Good For Merch <hello@toogoodformerch.com>".
EMAIL_FROM=""
# Internal inbox that receives a copy of every new bespoke request.
BESPOKE_NOTIFY_EMAIL=""
# WhatsApp Cloud API (Meta). Both required to enable the team WhatsApp ping.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Destination number (digits only, incl. country code) for the team ping.
WHATSAPP_NOTIFY_TO=""

# ---------------------------------------------------------------------------
# Public / client-safe (optional - safe to expose in the browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_PHONE=""
NEXT_PUBLIC_WHATSAPP_MESSAGE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
