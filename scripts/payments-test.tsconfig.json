{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "../.payments-test-build",
    "rootDir": "../src",
    "types": ["node"]
  },
  "include": [
    "../src/pricing/placements.ts",
    "../src/pricing/currency.ts",
    "../src/pricing/__tests__/**/*.ts",
    "../src/lib/payments/paymob.ts",
    "../src/lib/payments/__tests__/**/*.ts",
    "../src/lib/orders/display.ts",
    "../src/lib/orders/totals.ts",
    "../src/lib/orders/customer.ts",
    "../src/lib/orders/reuse.ts",
    "../src/lib/orders/errors.ts",
    "../src/lib/orders/__tests__/**/*.ts",
    "../src/lib/bespoke/eligibility.ts",
    "../src/lib/bespoke/snapshot.ts",
    "../src/lib/bespoke/__tests__/**/*.ts",
    "../src/lib/artwork/save.ts",
    "../src/lib/artwork/__tests__/**/*.ts",
    "../src/lib/notify/bespoke-content.ts",
    "../src/lib/notify/__tests__/**/*.ts",
    "../src/lib/admin/currency-aggregates.ts",
    "../src/lib/admin/notes.ts",
    "../src/lib/admin/__tests__/**/*.ts",
    "../src/lib/auth/bootstrap-role.ts",
    "../src/lib/auth/__tests__/**/*.ts",
    "../src/lib/rate-limit-core.ts",
    "../src/lib/svg-safety.ts",
    "../src/lib/__tests__/**/*.ts",
    "../src/studio/render/transform.ts",
    "../src/studio/render/placement-config.ts",
    "../src/studio/render/errors.ts",
    "../src/studio/render/types.ts",
    "../src/studio/guest-token.ts",
    "../src/studio/mockup-staleness.ts",
    "../src/studio/__tests__/**/*.ts",
    "../src/studio/ui/modals/modal-a11y.ts",
    "../src/studio/ui/modals/__tests__/**/*.ts",
    "../src/testing/**/*.ts"
  ]
}
